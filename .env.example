# Public site URL (production: https://anitaprinters.in)
NEXT_PUBLIC_SITE_URL=https://anitaprinters.in

# Google Search Console HTML tag verification token (optional)
GOOGLE_SITE_VERIFICATION=

# Neon PostgreSQL
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Admin login (seeded on first run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_RESET_PASSWORD=false

# Session signing — min 32 chars in production
SESSION_SECRET=

# ImageKit (product images)
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=

# Resend — quote enquiry emails (optional)
RESEND_API_KEY=
ADMIN_EMAIL=
RESEND_FROM_EMAIL=Anita Printers <onboarding@resend.dev>
