# Public site URL (production: https://anitaprinters.in)
NEXT_PUBLIC_SITE_URL=https://anitaprinters.in

# Search indexing — false until anitaprinters.in is live on Vercel, then set true
ALLOW_SEARCH_INDEXING=false

# Google Search Console HTML tag verification token (optional)
GOOGLE_SITE_VERIFICATION=

# Neon PostgreSQL
# Pooled (app runtime + Prisma) — Neon dashboard → "Pooled connection"
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Direct (migrations / prisma db push) — Neon dashboard → "Direct connection"
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Admin login — compared directly to these env values (no DB admin table)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Session signing — min 32 chars in production
SESSION_SECRET=

# ImageKit (product images)
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=

# Resend — quote enquiry emails (optional)
RESEND_API_KEY=
ADMIN_EMAIL=
RESEND_FROM_EMAIL=Anita Printers <onboarding@resend.dev>